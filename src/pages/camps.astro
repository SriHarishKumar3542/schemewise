---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CampsBoard from "@/components/CampsBoard";
---
<Base
  title="Upcoming Health Camps — SchemeWise"
  description="Find upcoming health screening camps by district and service — general, diabetes, eye, dental, women's health and vaccination."
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">Upcoming Health Camps</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      Free screening and health camps near you, filtered by district and service. Past camps are automatically marked as completed and hidden from the default view.
    </p>
    <div class="mt-8">
      <CampsBoard client:visible />
    </div>
  </main>
  <Footer />
</Base>
