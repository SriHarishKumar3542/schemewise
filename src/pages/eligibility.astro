---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EligibilityChecker from "@/components/EligibilityChecker";
---
<Base
  title="Check Eligibility — SchemeWise"
  description="Answer a few questions about age, state, income and occupation to see which health schemes you may qualify for."
>
  <Header />
  <main class="mx-auto max-w-4xl px-4 py-12 md:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">Check Your Eligibility</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      Answer the questions below and we'll compare them against the structured eligibility rules of each scheme in our directory. The results show schemes you <strong class="text-foreground">may potentially qualify for</strong> — final eligibility is always decided by the scheme authority.
    </p>
    <div class="mt-8">
      <EligibilityChecker client:visible />
    </div>
  </main>
  <Footer />
</Base>
