---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemeDirectory from "@/components/SchemeDirectory";
---
<Base
  title="Health Schemes – SchemeWise Directory"
  description="Search and filter government health schemes by state, benefit type and target group to find the support you may qualify for."
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">Health Scheme Directory</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      Every scheme is explained in simple language: who can apply, what you get, which documents you need and how to apply through official channels.
    </p>
    <div class="mt-8">
      <SchemeDirectory client:visible />
    </div>
  </main>
  <Footer />
</Base>
