---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { schemes } from "../lib/data";

const objectives = [
  { n: 1, t: "Simplify access to health schemes", d: "Help users discover relevant government health schemes without searching through multiple websites." },
  { n: 2, t: "Provide an eligibility checker", d: "Let users enter basic information and identify schemes they may potentially qualify for." },
  { n: 3, t: "Explain schemes clearly", d: "Present eligibility criteria, benefits, required documents and application procedures in simple language." },
  { n: 4, t: "Improve awareness of health camps", d: "Help users discover upcoming health screening and healthcare camps based on location and service." },
  { n: 5, t: "Guide users toward official sources", d: "Provide official government or authorized sources so users can verify information and continue the application process." },
  { n: 6, t: "Reduce information barriers", d: "Make health-support information easier to understand for people who may not be technically experienced." },
  { n: 7, t: "Create a practical social-benefit solution", d: "Demonstrate how technology can improve awareness of and access to public healthcare support." },
];

const modules = [
  { n: 1, t: "Eligibility Checker", d: "A short questionnaire matched against structured, machine-readable eligibility rules." },
  { n: 2, t: "Health Scheme Directory", d: "Searchable, filterable directory of government health schemes." },
  { n: 3, t: "Scheme Details & Application Guide", d: "Per-scheme pages: eligibility, benefits, documents, steps and official source." },
  { n: 4, t: "Health Camps", d: "Upcoming screening camps by district and service, with automatic completed marking." },
  { n: 5, t: "Find Help", d: "Guided recommendations by support type, using the same underlying data." },
  { n: 6, t: "About SchemeWise", d: "Project vision, objectives, modules and target users." },
  { n: 7, t: "Developer Information", d: "Who built this and why." },
];

const targetUsers = [
  "General public","Families looking for health-support schemes","Students and young adults",
  "Senior citizens and caregivers","People looking for free / low-cost health services",
  "People who find government scheme information difficult to navigate",
];
---
<Base
  title="About SchemeWise – Vision & Developer"
  description="SchemeWise makes public health information easier to discover — its vision, objectives, modules and the student developer behind it."
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <nav aria-label="On this page" class="flex flex-wrap gap-2">
      {["#about", "#objectives", "#modules", "#users", "#developer"].map((h, i) => (
        <a href={h} class="rounded-full border border-border bg-card px-4 py-2 text-sm font-semibold text-foreground hover:bg-muted">{["About SchemeWise", "Project Objectives", "Project Modules", "Target Users", "About the Developer"][i]}</a>
      ))}
    </nav>

    <section id="about" class="mt-10 scroll-mt-24">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">About SchemeWise</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground">
        SchemeWise is a social-benefit platform designed to make public health information easier to discover and understand. It helps users explore health schemes, check potential eligibility, understand application procedures and find upcoming health camps in one place.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-lg font-bold text-foreground">Our Vision</h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">To make access to health-support information simpler, clearer and more accessible through technology.</p>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-lg font-bold text-foreground">Our Approach</h2>
          <p class="mt-2 leading-relaxed text-muted-foreground">SchemeWise focuses on guidance and information rather than collecting unnecessary personal data or replacing official healthcare services.</p>
        </div>
      </div>
      <p class="mt-6 text-sm text-muted-foreground">Currently the directory covers {schemes.length} nationally relevant schemes and a sample set of health camps.</p>
    </section>

    <section id="objectives" class="mt-16 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Project Objectives</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        {objectives.map((o) => (
          <li class="flex items-start gap-4 rounded-2xl border border-border bg-card p-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-bold text-primary" aria-hidden="true">{o.n}</span>
            <div><h3 class="font-bold text-foreground">{o.t}</h3><p class="mt-1 text-sm leading-relaxed text-muted-foreground">{o.d}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="modules" class="mt-16 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Project Modules</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((m) => (
          <li class="rounded-2xl border border-border bg-card p-5">
            <span class="text-xs font-bold uppercase tracking-wide text-primary">Module {m.n}</span>
            <h3 class="mt-1 font-bold text-foreground">{m.t}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{m.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="users" class="mt-16 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Target Users</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">SchemeWise is designed primarily for:</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {targetUsers.map((u) => (
          <li class="flex items-start gap-2 rounded-xl border border-border bg-card p-4 text-foreground">
            <span class="mt-0.5 text-primary" aria-hidden="true">•</span>{u}
          </li>
        ))}
      </ul>
    </section>

    <section id="developer" class="mt-16 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">About the Developer</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-5">
        <div class="rounded-2xl border border-border bg-card p-6 md:col-span-2">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-secondary text-xl font-extrabold text-primary" aria-hidden="true">SH</span>
          <h3 class="mt-4 text-xl font-bold text-foreground">Sri Harish Kumar S</h3>
          <dl class="mt-4 space-y-2 text-sm">
            <div><dt class="font-semibold text-muted-foreground">Education</dt><dd class="text-foreground">B.E. Computer Science and Engineering</dd></div>
            <div><dt class="font-semibold text-muted-foreground">Year</dt><dd class="text-foreground">Second Year</dd></div>
            <div><dt class="font-semibold text-muted-foreground">Institution</dt><dd class="text-foreground">MIT Campus, Anna University</dd></div>
          </dl>
          <div class="mt-5 border-t border-border pt-4">
            <p class="text-xs font-bold uppercase tracking-wide text-muted-foreground">Links (to be added)</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href="mailto:sriharishkumar2008@gmail.com" class="rounded-full border border-border bg-background px-3 py-1 text-xs text-foreground hover:bg-muted">✉ Email — sriharishkumar2008@gmail.com</a>
              <a href="https://github.com/SriHarishKumar3542" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-3 py-1 text-xs text-foreground hover:bg-accent">GitHub</a>
              <a href="https://www.linkedin.com/in/sri-harish-kumar-s-4b44b1379" target="_blank" rel="noopener noreferrer" class="rounded-full border border-border px-3 py-1 text-xs text-foreground hover:bg-accent">LinkedIn</a>
            </div>
          </div>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6 md:col-span-3">
          <p class="leading-relaxed text-muted-foreground">
            "I'm a second-year Computer Science Engineering student at MIT Campus, Anna University. I'm building my foundation in programming and core computer science concepts, and I enjoy translating problems into working code — most recently through a cipher encryption project in C and C++.
          </p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            My goal is to strengthen my fundamentals, gain hands-on project experience, and start contributing in real engineering environments through internships." — Sri Harish Kumar S
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
