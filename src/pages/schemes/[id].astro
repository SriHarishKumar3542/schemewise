---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { schemes } from "../../lib/data";

export function getStaticPaths() {
  return schemes.map((s) => ({ params: { id: s.id }, props: { scheme: s } }));
}
const { scheme } = Astro.props;
---
<Base
  title={`${scheme.name} – Apply & Eligibility`}
  description={`${scheme.description.slice(0, 110)} Learn who can apply, benefits and how to apply via the official source.`}
  schema={[
    {
      "@type": "GovernmentService",
      name: scheme.name,
      description: scheme.description,
      url: scheme.officialUrl,
      provider: { "@type": "GovernmentOrganization", name: scheme.officialSource },
    },
  ]}
>
  <Header />
  <main class="mx-auto max-w-4xl px-4 py-12 md:py-16">
    <a href="/schemes" class="text-sm font-semibold text-primary hover:underline">← Back to Health Schemes</a>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-primary">{scheme.benefitType}</span>
      <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">{scheme.stateCoverage}</span>
    </div>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">{scheme.name}</h1>

    <section class="mt-8" aria-labelledby="overview">
      <h2 id="overview" class="text-xl font-bold text-foreground">Overview</h2>
      <p class="mt-3 leading-relaxed text-muted-foreground">{scheme.description}</p>
    </section>

    <section class="mt-8" aria-labelledby="who">
      <h2 id="who" class="text-xl font-bold text-foreground">Who Can Apply?</h2>
      <ul class="mt-3 space-y-2">
        {scheme.targetGroups.map((t) => (
          <li class="flex items-start gap-2 text-foreground"><span class="mt-0.5 text-primary" aria-hidden="true">•</span>{t}</li>
        ))}
      </ul>
      {scheme.eligibilityRules.otherCriteria && (
        <p class="mt-3 rounded-xl bg-muted p-4 text-sm leading-relaxed text-foreground"><strong>Conditions to know:</strong> {scheme.eligibilityRules.otherCriteria}</p>
      )}
    </section>

    <section class="mt-8" aria-labelledby="benefits">
      <h2 id="benefits" class="text-xl font-bold text-foreground">Benefits</h2>
      <ul class="mt-3 space-y-2">
        {scheme.benefits.map((b) => (
          <li class="flex items-start gap-2 text-foreground"><span class="mt-0.5 text-primary" aria-hidden="true">✓</span>{b}</li>
        ))}
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="documents">
      <h2 id="documents" class="text-xl font-bold text-foreground">Required Documents</h2>
      {scheme.requiredDocuments.length === 0 ? (
        <p class="mt-3 text-muted-foreground">No documents are needed — this support is provided automatically through schools or health facilities.</p>
      ) : (
        <ul class="mt-3 space-y-2">
          {scheme.requiredDocuments.map((d) => (
            <li class="flex items-start gap-2 text-foreground"><span class="mt-0.5 text-primary" aria-hidden="true">•</span>{d}</li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8" aria-labelledby="apply">
      <h2 id="apply" class="text-xl font-bold text-foreground">How to Apply</h2>
      <ol class="mt-3 space-y-3">
        {scheme.applicationSteps.map((s, i) => (
          <li class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-bold text-primary">{i + 1}</span>
            <span class="leading-relaxed text-foreground">{s}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-labelledby="source">
      <h2 id="source" class="text-xl font-bold text-foreground">Official Source</h2>
      <p class="mt-3 text-muted-foreground">{scheme.officialSource}</p>
      <a href={scheme.officialUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 font-semibold text-primary hover:underline">
        {scheme.officialUrl.replace(/^https?:\/\//, "")}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg>
      </a>
      <p class="mt-2 text-sm text-muted-foreground">Last updated: {scheme.lastUpdated}</p>
    </section>

    <aside class="mt-10 rounded-2xl border-s-4 border-accent bg-muted p-5">
      <p class="text-sm leading-relaxed text-foreground">
        <strong>Important Notice:</strong> SchemeWise provides information and eligibility guidance. Final eligibility and approval are determined by the respective scheme authority.
      </p>
    </aside>
  </main>
  <Footer />
</Base>
