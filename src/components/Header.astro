---
const links = [
  { href: "/", label: "Home" },
  { href: "/eligibility", label: "Check Eligibility" },
  { href: "/schemes", label: "Health Schemes" },
  { href: "/camps", label: "Health Camps" },
  { href: "/find-help", label: "Find Help" },
  { href: "/about", label: "About" },
];
---
<header class="sticky top-0 z-40 border-b border-border bg-card/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-foreground" aria-label="SchemeWise home">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg>
      </span>
      SchemeWise
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {links.map((l) => (
        <a href={l.href} class="rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground">{l.label}</a>
      ))}
      <a href="/eligibility" class="ms-2 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Check My Eligibility</a>
    </nav>
    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label for="nav-toggle" class="flex h-10 w-10 items-center justify-center rounded-lg border border-border md:hidden" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </label>
    <nav class="absolute inset-x-0 top-16 hidden border-b border-border bg-card p-4 peer-checked:block md:hidden" aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1">
        {links.map((l) => (
          <li><a href={l.href} class="block rounded-lg px-3 py-3 text-base font-medium text-foreground hover:bg-secondary">{l.label}</a></li>
        ))}
        <li class="mt-2"><a href="/eligibility" class="block rounded-lg bg-primary px-3 py-3 text-center text-base font-semibold text-primary-foreground">Check My Eligibility</a></li>
      </ul>
    </nav>
  </div>
</header>
